{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/build", "destination": "/build.js" },
    { "source": "/api/status", "destination": "/status.js" },
    { "source": "/api/download", "destination": "/download.js" }
  ],
  "functions": {
    "build.js": {
      "maxDuration": 30,
      "memory": 1024
    },
    "status.js": {
      "maxDuration": 15,
      "memory": 512
    },
    "download.js": {
      "maxDuration": 15,
      "memory": 512
    }
  }
}
